node_modules/

.expo/

dist/

web-build/

.env
.env.*
!.env.example

backend/.env
backend/.env.*
!backend/.env.example

# Base SQLite locale (developpement) : donnees reelles, jamais dans git.
backend/data/

# Artefacts de build natifs. Deja couverts par android/.gitignore, mais
# repetes ici : le .gitignore racine est le seul que certains outils lisent,
# et un autolinking.json genere sous Windows casse les builds Linux (EAS).
android/build/
android/.gradle/
android/app/build/
android/app/.cxx/
android/local.properties
ios/build/
ios/Pods/

# Cle de publication Android et ses mots de passe. Une fuite est
# irrattrapable : quiconque la detient peut signer une mise a jour que les
# telephones deja equipes accepteront comme venant de nous.
# debug.keystore fait exception : cle publique du modele Android, sans valeur.
android/keystore.properties
*.jks
*.keystore
!android/app/debug.keystore
